PORT=3000

# String de conexão do PostgreSQL. Se usar Supabase/Neon/RDS, cole a
# connection string que eles fornecem aqui.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/hairspace

# true quando o provedor de Postgres exigir SSL (ex: Supabase, Neon, RDS gerenciado)
DB_SSL=false

# Troque por uma string longa e aleatória antes de subir para produção
JWT_SECRET=troque_esta_chave_por_uma_bem_grande_e_aleatoria

# Endereço do front, para o CORS aceitar as requisições dele
CORS_ORIGIN=http://localhost:5173
